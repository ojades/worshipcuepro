{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "projector_window",
    "stage_window",
    "splashscreen"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "dialog:default",
    "sql:allow-execute",
    "dialog:allow-open",
    "fs:default",
    "shell:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT/**"
        }
      ]
    },
    "process:default"
  ]
}