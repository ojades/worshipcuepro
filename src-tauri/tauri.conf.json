{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "worshipcuepro",
  "version": "0.1.10",
  "identifier": "com.worshipcuepro.cue",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WorshipCuePro",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "resizable": true,
        "visible": false
      },
      {
        "title": "",
        "label": "splashscreen",
        "url": "/splash.html",
        "width": 400,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../build/**/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMEI5RjU0QTFBNUQ0NkMKUldSczFLV2hWSjhMc2Q3aVBDNVhTcXZabUJ6YXFFaHdlSkNyM0s5ZmM1dzkzQjRlQU9hY0N0ZXYK",
      "endpoints": [
        "https://pub-476fcfea486849dbb44781f977ba0e65.r2.dev/latest.json"
      ]
    }
  }
}
